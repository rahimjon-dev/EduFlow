{
  "name": "eduflow",
  "version": "1.0.0",
  "private": true,
  "description": "EduFlow - Modern Education Management Platform",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "backend:dev": "npm run dev --prefix eduflow-backend",
    "backend:start": "npm run start --prefix eduflow-backend",
    "prisma:studio": "npm run prisma:studio --prefix eduflow-backend",
    "build": "npm --prefix eduflow-backend install && npm --prefix eduflow-backend run prisma:generate && npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node eduflow-backend/server.js",
    "preview": "npm run preview --prefix frontend",
    "mobile": "npm run start --prefix mobile",
    "mobile:web": "npm run web --prefix mobile",
    "mobile:android": "npm run android --prefix mobile",
    "mobile:ios": "npm run ios --prefix mobile",
    "mobile:tunnel": "npm run tunnel --prefix mobile",
    "mobile:build:apk": "npm run build:apk --prefix mobile",
    "mobile:update": "npm run update --prefix mobile",
    "mobile:install": "npm install --prefix mobile",
    "audit": "node eduflow-backend/audit_test_suite.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
